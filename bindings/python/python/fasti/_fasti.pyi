"""Type stubs for the compiled half of fasti.

Date positions are spelled `datetime.date` outright. Note that a type
checker cannot reject a `datetime.datetime` there: `datetime` subclasses
`date`, so it type-checks. The runtime rejects it.
"""

import datetime
from collections.abc import Iterable, Iterator
from fractions import Fraction
from typing import final

class FastiError(ValueError):
    """Every refusal the crate's `TimeError` names. Type mistakes raise `TypeError`."""

@final
class BusinessDayConvention:
    UNADJUSTED: BusinessDayConvention
    FOLLOWING: BusinessDayConvention
    MODIFIED_FOLLOWING: BusinessDayConvention
    PRECEDING: BusinessDayConvention
    MODIFIED_PRECEDING: BusinessDayConvention
    def __new__(cls, spelling: BusinessDayConvention | str) -> BusinessDayConvention: ...
    def __hash__(self) -> int: ...
    def __reduce__(self) -> tuple[object, tuple[str]]: ...

