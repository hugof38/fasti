@final
class Schedule:
    def __new__(
        cls,
        effective: datetime.date,
        termination: datetime.date,
        tenor: Period | Frequency | str,
        calendar: Calendar,
        *,
        convention: BusinessDayConvention | str | None = None,
        termination_convention: BusinessDayConvention | str | None = None,
        rule: DateGenerationRule | str | None = None,
        end_of_month: bool = False,
        first_date: datetime.date | None = None,
        next_to_last_date: datetime.date | None = None,
    ) -> Schedule: ...
    @staticmethod
    def from_dates(dates: Iterable[datetime.date]) -> Schedule: ...
    def dates(self) -> list[datetime.date]: ...
    def periods(self) -> list[tuple[datetime.date, datetime.date]]: ...
    def reference_periods(self) -> list[tuple[datetime.date, datetime.date]]: ...
    def generation(self) -> Generation | None: ...
    def previous_date(self, ref_date: datetime.date) -> datetime.date | None: ...
    def next_date(self, ref_date: datetime.date) -> datetime.date | None: ...
    def lower_bound(self, ref_date: datetime.date) -> datetime.date | None: ...
    def after(self, cutoff: datetime.date) -> Schedule: ...
    def until(self, cutoff: datetime.date) -> Schedule: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> datetime.date: ...
    def __iter__(self) -> Iterator[datetime.date]: ...
    def __hash__(self) -> int: ...
    def __reduce__(
        self,
    ) -> tuple[object, tuple[object, list[tuple[str, object]]]]: ...

