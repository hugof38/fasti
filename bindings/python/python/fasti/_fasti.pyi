# The registry the `fasti.calendars` package is built from, and the
# pickle hooks every __reduce__ names.
def _builtin(name: str) -> Calendar: ...
def _rebuild_calendar(origin: object, ops: list[object]) -> Calendar: ...
def _rebuild_daycount(state: tuple[object, ...]) -> DayCount: ...
def _rebuild_generation(unit: str, length: int, end_of_month: bool) -> Generation: ...
def _rebuild_period(unit: str, length: int) -> Period: ...
def _rebuild_rule(state: tuple[object, ...]) -> Rule: ...
def _rebuild_schedule(origin: object, ops: list[object]) -> Schedule: ...
