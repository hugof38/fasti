@final
class Rule:
    @staticmethod
    def fixed(
        month: int,
        day: int,
        *,
        shift: WeekendShift | str | None = None,
        years: tuple[int | None, int | None] | None = None,
    ) -> Rule: ...
    @staticmethod
    def nth_weekday(
        n: int,
        weekday: Weekday | str,
        month: int,
        *,
        years: tuple[int | None, int | None] | None = None,
    ) -> Rule: ...
    @staticmethod
    def last_weekday(
        weekday: Weekday | str,
        month: int,
        *,
        years: tuple[int | None, int | None] | None = None,
    ) -> Rule: ...
    @staticmethod
    def easter(
        days: int,
        *,
        method: EasterMethod | str | None = None,
        years: tuple[int | None, int | None] | None = None,
    ) -> Rule: ...
    @staticmethod
    def one_off(date: datetime.date) -> Rule: ...
    def is_holiday(self, date: datetime.date) -> bool: ...
    def __hash__(self) -> int: ...
    def __reduce__(self) -> tuple[object, tuple[tuple[object, ...]]]: ...

@final
class Calendar:
    def __new__(
        cls,
        name: str,
        weekend: Iterable[Weekday | str] = (),
        rules: Iterable[Rule] = (),
    ) -> Calendar: ...
    @property
    def name(self) -> str: ...
    @property
    def weekend(self) -> tuple[Weekday, ...]: ...
    def with_name(self, name: str) -> Calendar: ...
    def with_weekend(self, weekend: Iterable[Weekday | str]) -> Calendar: ...
    def with_rule(self, rule: Rule) -> Calendar: ...
    def union(self, other: Calendar) -> Calendar: ...
    def is_weekend(self, date: datetime.date) -> bool: ...
    def is_holiday(self, date: datetime.date) -> bool: ...
    def is_business_day(self, date: datetime.date) -> bool: ...
    def business_days(
        self, start: datetime.date, end: datetime.date
    ) -> list[datetime.date]: ...
    def holidays(self, start: datetime.date, end: datetime.date) -> list[datetime.date]: ...
    def first_business_day_of_month(self, date: datetime.date) -> datetime.date | None: ...
    def last_business_day_of_month(self, date: datetime.date) -> datetime.date | None: ...
    def next_business_day(self, date: datetime.date) -> datetime.date | None: ...
    def prev_business_day(self, date: datetime.date) -> datetime.date | None: ...
    def adjust(
        self, date: datetime.date, convention: BusinessDayConvention | str
    ) -> datetime.date: ...
    def advance(
        self,
        date: datetime.date,
        period: Period | Frequency | str,
        convention: BusinessDayConvention | str,
        end_of_month: bool = False,
    ) -> datetime.date: ...
    def __hash__(self) -> int: ...
    def __reduce__(
        self,
    ) -> tuple[object, tuple[object, list[tuple[str, object]]]]: ...

